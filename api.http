### ============================================================
### 10. ACESSAR ROTA PROTEGIDA SEM TOKEN
### Esperado: 401
### ============================================================

GET {{baseUrl}}/todos


### ============================================================
### 11. ACESSAR ROTA PROTEGIDA COM TOKEN INVÁLIDO
### Esperado: 401
### ============================================================

GET {{baseUrl}}/todos
Authorization: Bearer token_invalido_123


### ============================================================
### 12. ATUALIZAR TODO INEXISTENTE
### Esperado: 404
### ============================================================

PUT {{baseUrl}}/todos/999
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "title": "Test",
  "description": "Todo inexistente",
  "completed": true
}


### ============================================================
### 13. ATUALIZAÇÃO PARCIAL — SOMENTE COMPLETED
### Esperado: 200
### ============================================================

PUT {{baseUrl}}/todos/{{todoId}}
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "completed": true
}


### ============================================================
### 14. DADOS INVÁLIDOS — COMPLETED COMO STRING
### Esperado: 400
### ============================================================

POST {{baseUrl}}/todos
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "title": "Teste Zod",
  "description": "Testando validação",
  "completed": "true"
}


