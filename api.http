### ============================================================
### 17. JOÃO TENTA ALTERAR TODO DA MARIA
### Esperado: 404
### ============================================================

PUT {{baseUrl}}/todos/{{todoId}}
Content-Type: application/json
Authorization: Bearer {{joaoToken}}

{
  "title": "João tentando alterar",
  "description": "Não deveria conseguir",
  "completed": true
}


### ============================================================
### 18. JOÃO TENTA DELETAR TODO DA MARIA
### Esperado: 404
### ============================================================

DELETE {{baseUrl}}/todos/{{todoId}}
Authorization: Bearer {{joaoToken}}


### ============================================================
### 19. MARIA DELETA SUA PRÓPRIA TAREFA
### Esperado: 200
### ============================================================

DELETE {{baseUrl}}/todos/{{todoId}}
Authorization: Bearer {{authToken}}


### ============================================================
### 20. MARIA TENTA ALTERAR A TAREFA DELETADA
### Esperado: 404
### ============================================================

PUT {{baseUrl}}/todos/{{todoId}}
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "title": "Tentando alterar tarefa deletada",
  "description": "Não deveria existir",
  "completed": true
}