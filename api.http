### ============================================================
### 22. JOÃO TENTA ALTERAR TODO DA MARIA
### Esperado: 404
### ============================================================

PUT {{baseUrl}}/todos/{{todoId}}
Content-Type: application/json
Authorization: Bearer {{joaoToken}}

{
  "title": "João tentando alterar",
  "description": "Não deveria conseguir",
  "completed": true
}


### ============================================================
### 23. JOÃO TENTA DELETAR TODO DA MARIA
### Esperado: 404
### ============================================================

DELETE {{baseUrl}}/todos
Authorization: Bearer {{joaoToken}}


### ============================================================
### 24. MARIA DELETA SUA PRÓPRIA TAREFA
### Esperado: 204
### ============================================================

DELETE {{baseUrl}}/todos/6
Authorization: Bearer {{authToken}}


### ============================================================
### 25. MARIA TENTA ALTERAR A TAREFA DELETADA
### Esperado: 404
### ============================================================

PUT {{baseUrl}}/todos/6
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "title": "Tentando alterar tarefa deletada",
  "description": "Não deveria existir",
  "completed": true
}