@baseUrl = https://sturdy-waffle-wpxjv77v94qh9qv5-3000.app.github.dev


### ============================================================
### 1. REGISTRAR USUÁRIO — MARIA
### Esperado: 201
### ============================================================

# @name registerMaria

POST {{baseUrl}}/users/register
Content-Type: application/json

{
  "name": "Maria Silva",
  "email": "maria@email.com",
  "password": "123456"
}


### ============================================================
### 2. LOGIN — MARIA
### Esperado: 200
### ============================================================

# @name loginMaria

POST {{baseUrl}}/users/login
Content-Type: application/json

{
  "email": "maria@email.com",
  "password": "123456"
}


###
# Token da Maria
@authToken = {{loginMaria.response.body.$.token}}


### ============================================================
### 3. LISTAR TODOS — MARIA
### Esperado: 200
### ============================================================

GET {{baseUrl}}/todos
Authorization: Bearer {{authToken}}


### ============================================================
### 4. CRIAR TODO — MARIA
### Esperado: 201
### ============================================================

# @name createTodo

POST {{baseUrl}}/todos
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "title": "Teste criação",
  "description": "Testando criação",
  "completed": false
}


###
# ID da tarefa criada pela Maria
@todoId = {{createTodo.response.body.$.id}}


### ============================================================
### 5. ATUALIZAR TODO — MARIA
### Esperado: 200
### ============================================================

PUT {{baseUrl}}/todos/{{todoId}}
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "title": "Estudar Zod",
  "description": "Estudar validação",
  "completed": false
}


### ============================================================
### 6. ATUALIZAR TODO — COMPLETED
### Esperado: 200
### ============================================================

PUT {{baseUrl}}/todos/{{todoId}}
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "title": "Estudar Node.js e Prisma",
  "description": "Revisar arquitetura, Express e Prisma",
  "completed": true
}


### ============================================================
### 7. LISTAR NOVAMENTE
### Confirma se a alteração foi persistida
### Esperado: 200
### ============================================================

GET {{baseUrl}}/todos
Authorization: Bearer {{authToken}}


### ============================================================
### 8. FILTRO — TAREFAS CONCLUÍDAS
### Esperado: 200
### Deve retornar somente completed = true
### ============================================================

GET {{baseUrl}}/todos?page=1&limit=10&completed=true
Authorization: Bearer {{authToken}}


### ============================================================
### 9. FILTRO — TAREFAS PENDENTES
### Esperado: 200
### Deve retornar somente completed = false
### ============================================================

GET {{baseUrl}}/todos?page=1&limit=10&completed=false
Authorization: Bearer {{authToken}}


### ============================================================
### 10. SEM FILTRO — TODAS AS TAREFAS
### Esperado: 200
### Deve retornar todas as tarefas da Maria
### ============================================================

GET {{baseUrl}}/todos?page=1&limit=20
Authorization: Bearer {{authToken}}


### ============================================================
### 11. REGISTRAR E-MAIL JÁ EXISTENTE
### Esperado: 409
### ============================================================

POST {{baseUrl}}/users/register
Content-Type: application/json

{
  "name": "Outra Maria",
  "email": "maria@email.com",
  "password": "123456"
}


### ============================================================
### 12. LOGIN COM SENHA ERRADA
### Esperado: 401
### ============================================================

POST {{baseUrl}}/users/login
Content-Type: application/json

{
  "email": "maria@email.com",
  "password": "senhaErrada"
}


### ============================================================
### 13. ACESSAR ROTA PROTEGIDA SEM TOKEN
### Esperado: 401
### ============================================================

GET {{baseUrl}}/todos


### ============================================================
### 14. ACESSAR ROTA PROTEGIDA COM TOKEN INVÁLIDO
### Esperado: 401
### ============================================================

GET {{baseUrl}}/todos
Authorization: Bearer token_invalido_123


### ============================================================
### 15. ATUALIZAR TODO INEXISTENTE
### Esperado: 404
### ============================================================

PUT {{baseUrl}}/todos/999
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "title": "Test",
  "description": "Todo inexistente",
  "completed": true
}


### ============================================================
### 16. ATUALIZAÇÃO PARCIAL — SOMENTE COMPLETED
### Esperado: 200
### ============================================================

PUT {{baseUrl}}/todos/{{todoId}}
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "completed": true
}


### ============================================================
### 17. DADOS INVÁLIDOS — COMPLETED COMO STRING
### Esperado: 400
### ============================================================

POST {{baseUrl}}/todos
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "title": "Teste Zod",
  "description": "Testando validação",
  "completed": "true"
}


### ============================================================
### 18. TESTE — CAMPO DE ORDENAÇÃO INVÁLIDO
### Esperado: 400
### sortBy=password não é permitido
### ============================================================

GET {{baseUrl}}/todos?page=1&limit=10&sortBy=password&order=asc
Authorization: Bearer {{authToken}}


### ============================================================
### 19. TESTE — ORDEM DE ORDENAÇÃO INVÁLIDA
### Esperado: 400
### order=banana não é permitido
### ============================================================

GET {{baseUrl}}/todos?page=1&limit=10&sortBy=title&order=banana
Authorization: Bearer {{authToken}}


