@baseUrl = https://sturdy-waffle-wpxjv77v94qh9qv5-3000.app.github.dev


### ============================================================
### 1. REGISTRAR USUÁRIO — MARIA
### Esperado: 201
### ============================================================

# @name registerMaria

POST {{baseUrl}}/users/register
Content-Type: application/json

{
  "name": "Maria Silva",
  "email": "maria@email.com",
  "password": "123456"
}


### ============================================================
### 2. LOGIN — MARIA
### Esperado: 200
### ============================================================

# @name loginMaria

POST {{baseUrl}}/users/login
Content-Type: application/json

{
  "email": "maria@email.com",
  "password": "123456"
}


###
# Token da Maria
@authToken = {{loginMaria.response.body.token}}


### ============================================================
### 3. LISTAR TODOS — MARIA
### Esperado: 200
### ============================================================

GET {{baseUrl}}/todos?page=2&limit=2
Authorization: Bearer {{authToken}}


### ============================================================
### 4. CRIAR TODO — MARIA
### Esperado: 201
### ============================================================

# @name createTodo

POST {{baseUrl}}/todos
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "title": "Testar error middleware",
  "description": "Testando a API",
  "completed": false
}


###
# ID da tarefa criada pela Maria
@todoId = {{createTodo.response.body.id}}


### ============================================================
### 5. ATUALIZAR TODO — MARIA
### Esperado: 200
### ============================================================

PUT {{baseUrl}}/todos/{{todoId}}
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "title": "Estudar Zod",
  "description": "Estudar validação",
  "completed": false
}


### ============================================================
### 6. ATUALIZAR TODO — COMPLETED
### Esperado: 200
### ============================================================

PUT {{baseUrl}}/todos/{{todoId}}
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "title": "Estudar Node.js e Prisma",
  "description": "Revisar arquitetura, Express e Prisma",
  "completed": true
}


### ============================================================
### 7. LISTAR NOVAMENTE
### Confirma se a alteração foi persistida
### Esperado: 200
### ============================================================

GET {{baseUrl}}/todos
Authorization: Bearer {{authToken}}


