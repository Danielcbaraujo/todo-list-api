```http
@baseUrl =https://sturdy-waffle-wpxjv77v94qh9qv5-3000.app.github.dev
### ============================================
### 1. REGISTRAR USUÁRIO
### ============================================
# @name register

POST {{baseUrl}}/users/register
Content-Type: application/json

{
  "name": "Maria Silva",
  "email": "maria@email.com",
  "password": "123456"
}


### ============================================
### 2. LOGIN
### ============================================
# @name login

POST {{baseUrl}}/users/login
Content-Type: application/json

{
  "email": "maria@email.com",
  "password": "123456"
}

### Captura o token retornado no login
@authToken = {{login.response.body.token}}


### ============================================
### 3. LISTAR TODOS
### ============================================

GET {{baseUrl}}/todos
Authorization: Bearer {{authToken}}


### ============================================
### 4. CRIAR TODO
### ============================================
# @name createTodo

POST {{baseUrl}}/todos
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "title": "Estudar Zod",
  "description": "Aprender validação",
  "completed": "sim"
}

### Captura o ID da Todo criada
@todoId = {{createTodo.response.body.id}}


### ============================================
### 5. ATUALIZAR TODO — TÍTULO E DESCRIÇÃO
### ============================================

PUT {{baseUrl}}/todos/5
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "title": "Estudar Node.js e Prisma",
  "description": "Revisar arquitetura, Express e Prisma",
  "completed": false
}


### ============================================
### 6. ATUALIZAR TODO — COMPLETED
### ============================================

PUT {{baseUrl}}/todos/{{todoId}}
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "title": "Estudar Node.js e Prisma",
  "description": "Revisar arquitetura, Express e Prisma",
  "completed": true
}


### ============================================
### 7. LISTAR NOVAMENTE
### Confirma se a alteração foi persistida
### ============================================

GET {{baseUrl}}/todos
Authorization: Bearer {{authToken}}


### ============================================
### CASOS DE ERRO
### ============================================


### ============================================
### 8. REGISTRAR E-MAIL JÁ EXISTENTE
### Esperado: 409
### ============================================

POST {{baseUrl}}/users/register
Content-Type: application/json

{
  "name": "Outra Maria",
  "email": "maria@email.com",
  "password": "123456"
}


### ============================================
### 9. LOGIN COM SENHA ERRADA
### Esperado: 401
### ============================================

POST {{baseUrl}}/users/login
Content-Type: application/json

{
  "email": "maria@email.com",
  "password": "senhaErrada"
}


### ============================================
### 10. ACESSAR ROTA PROTEGIDA SEM TOKEN
### Esperado: 401
### ============================================

GET {{baseUrl}}/todos


### ============================================
### 11. ACESSAR ROTA PROTEGIDA COM TOKEN INVÁLIDO
### Esperado: 401
### ============================================

GET {{baseUrl}}/todos
Authorization: Bearer token_invalido_123


### ============================================
### 12. ATUALIZAR TODO INEXISTENTE
### Esperado: 404
### ============================================

PUT {{baseUrl}}/todos/id-que-nao-existe
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "title": "Teste",
  "description": "Todo inexistente",
  "completed": true
}

### ============================================
### 13. ATUALIZAÇÃO PARCIAL — SOMENTE COMPLETED
### ============================================

PUT {{baseUrl}}/todos/{{todoId}}
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "completed": true
}


### ============================================
### 13. DELETAR TODO
### Esperado: 200
### ============================================

DELETE {{baseUrl}}/todos/4
Authorization: Bearer {{authToken}}